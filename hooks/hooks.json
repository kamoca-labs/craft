{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/ste.ts\"",
            "timeout": 10,
            "statusMessage": "craft:ste: escrita no padrão ASD-STE100"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/memory.ts\"",
            "timeout": 10,
            "statusMessage": "craft:memory: memória do projeto"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/memory-outside-project.ts\"",
            "timeout": 10,
            "statusMessage": "craft:memory-outside-project: memória no projeto?"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/atdd-first.ts\"",
            "timeout": 10,
            "statusMessage": "craft:atdd-first: fluxo carregado antes do código?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/english-code.ts\"",
            "timeout": 10,
            "statusMessage": "craft:english-code: código em inglês?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/test-id.ts\"",
            "timeout": 10,
            "statusMessage": "craft:test-id: elemento interativo com data-testid?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/test-skip.ts\"",
            "timeout": 10,
            "statusMessage": "craft:test-skip: teste pulado ou focado?"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/e2e-container.ts\"",
            "timeout": 10,
            "statusMessage": "craft:e2e-container: E2E em container?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/filtered-tests.ts\"",
            "timeout": 10,
            "statusMessage": "craft:filtered-tests: testes com filtro?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/push-gate.ts\"",
            "timeout": 10,
            "statusMessage": "craft:push-gate: suíte completa antes do push?"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/refactor-on-green.ts\"",
            "timeout": 10,
            "statusMessage": "craft:refactor-on-green: suíte verde?"
          }
        ]
      }
    ]
  }
}
