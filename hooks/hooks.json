{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/ste.ts\"",
            "timeout": 10,
            "statusMessage": "craft:ste: writing in the ASD-STE100 standard"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/memory.ts\"",
            "timeout": 10,
            "statusMessage": "craft:memory: project memory"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/tasks.ts\"",
            "timeout": 10,
            "statusMessage": "craft:tasks: tasks and goal"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/tool.ts\"",
            "timeout": 10,
            "statusMessage": "craft:tool: Claude is the user's tool"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/verify.ts\"",
            "timeout": 10,
            "statusMessage": "craft:verify: verify facts before you trust them"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/challenge.ts\"",
            "timeout": 10,
            "statusMessage": "craft:challenge: the claim is wrong until a fact proves it"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/state-of-the-art.ts\"",
            "timeout": 10,
            "statusMessage": "craft:state-of-the-art: research current practice before you implement"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/meta-goal.ts\"",
            "timeout": 10,
            "statusMessage": "craft:meta-goal: goal closed?"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/memory-outside-project.ts\"",
            "timeout": 10,
            "statusMessage": "craft:memory-outside-project: memory in the project?"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/atdd-first.ts\"",
            "timeout": 10,
            "statusMessage": "craft:atdd-first: flow loaded before code?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/english-code.ts\"",
            "timeout": 10,
            "statusMessage": "craft:english-code: code in English?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/test-id.ts\"",
            "timeout": 10,
            "statusMessage": "craft:test-id: interactive element with data-testid?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/test-skip.ts\"",
            "timeout": 10,
            "statusMessage": "craft:test-skip: test skipped or focused?"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/e2e-container.ts\"",
            "timeout": 10,
            "statusMessage": "craft:e2e-container: E2E in a container?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/filtered-tests.ts\"",
            "timeout": 10,
            "statusMessage": "craft:filtered-tests: tests with a filter?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/push-gate.ts\"",
            "timeout": 10,
            "statusMessage": "craft:push-gate: full suite before the push?"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/refactor-on-green.ts\"",
            "timeout": 10,
            "statusMessage": "craft:refactor-on-green: suite green?"
          }
        ]
      }
    ]
  }
}
