{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/activity-gate.ts\"",
            "timeout": 15,
            "statusMessage": "craft:activity-gate: activity verified?"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/memory-outside-project.ts\"",
            "timeout": 10,
            "statusMessage": "craft:memory-outside-project: memory in the project?"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/test-first.ts\"",
            "timeout": 10,
            "statusMessage": "craft:test-first: a test before the code?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/research-first.ts\"",
            "timeout": 10,
            "statusMessage": "craft:research-first: research before infra and versions?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/english-code.ts\"",
            "timeout": 10,
            "statusMessage": "craft:english-code: code in English?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/test-id.ts\"",
            "timeout": 10,
            "statusMessage": "craft:test-id: interactive element with data-testid?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/test-skip.ts\"",
            "timeout": 10,
            "statusMessage": "craft:test-skip: test skipped or focused?"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/no-shell-edit.ts\"",
            "timeout": 10,
            "statusMessage": "craft:no-shell-edit: file edited by shell?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/e2e-container.ts\"",
            "timeout": 10,
            "statusMessage": "craft:e2e-container: E2E in a container?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/filtered-tests.ts\"",
            "timeout": 10,
            "statusMessage": "craft:filtered-tests: tests with a filter?"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/push-gate.ts\"",
            "timeout": 10,
            "statusMessage": "craft:push-gate: full suite before the push?"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/refactor-on-green.ts\"",
            "timeout": 10,
            "statusMessage": "craft:refactor-on-green: suite green?"
          }
        ]
      }
    ]
  }
}
